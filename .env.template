XAI_OCR_MODEL=

MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_CHAT_MODELS=
MISTRAL_OCR_MODEL=

# OpenCode 一个账号、多种协议；复制控制台中与模型对应的 API 地址。
