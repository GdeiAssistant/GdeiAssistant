# =============================================================================
# GdeiAssistant 环境变量模板（可提交到 Git）
# 使用前复制为 .env；Docker Compose 与 Spring Boot 统一读取该文件。
# 模板可提交到 Git，真实凭据不要提交。
# 说明：
# 1. 带默认值的变量通常可保持不变
# 2. 标注“必填”的变量需要提供真实值
# 3. 标注“按需”的变量仅在启用对应能力时配置
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 运行入口端口
# SERVER_PORT 用于本地 ./gradlew bootRun
# *_EXPOSE_PORT 用于 Docker 对宿主机暴露的端口
# 端口变量为可选覆盖项，仅在端口冲突时调整
# -----------------------------------------------------------------------------
SERVER_PORT=8080
BACKEND_EXPOSE_PORT=8080
FRONTEND_EXPOSE_PORT=5173
FRONTEND_STAGING_EXPOSE_PORT=8088
FRONTEND_PROD_EXPOSE_PORT=80
MYSQL_EXPOSE_PORT=3306
REDIS_EXPOSE_PORT=6379
MONGO_EXPOSE_PORT=27017

# -----------------------------------------------------------------------------
# 2. Spring / 本地直跑数据库连接
# 本地 bootRun 通常使用 localhost；Docker Compose 内部会自动改为 mysql/redis/mongodb
# 本地运行通常至少需要正确配置 DB_PASSWORD 和 JWT_SECRET
# -----------------------------------------------------------------------------

# Spring Profile：可选；统一使用 development / staging / production
SPRING_PROFILES_ACTIVE=development

# MySQL：本地直跑后端通常需要；使用 Docker Compose 时默认走 root@localhost
# 演示 / 生产若接外部 MySQL，可改 DB_USERNAME / DB_JDBC_PARAMS，或直接覆盖三套 JDBC URL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gdeiassistant
DB_NAME_LOG=gdeiassistant_log
DB_NAME_DATA=gdeiassistant_data
DB_USERNAME=root
DB_PASSWORD=
DB_JDBC_PARAMS=useUnicode=true&characterEncoding=utf-8&useSSL=true&requireSSL=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_JDBC_URL_APP=
DB_JDBC_URL_LOG=
DB_JDBC_URL_DATA=

# Redis：按需；外部托管 Redis 如要求 ACL/TLS，可配置 REDIS_USERNAME / REDIS_SSL_ENABLED
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_SSL_ENABLED=false

# MongoDB：按需；本地默认走 host/port/database
# 如使用外部托管 MongoDB，优先填写完整连接串 MONGO_URI（包含账号、密码、TLS、数据库）
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=gdeiassistant
MONGO_URI=

# 必填：JWT 签名密钥，建议至少 32 位随机串
JWT_SECRET=

# 必填（生产）：定时任务触发密钥，用于 /cron/* 端点鉴权
CRON_SECRET=

# -----------------------------------------------------------------------------
# 3. 前端运行时
# 开发环境默认指向宿主机后端；生产镜像默认使用 /api
# 如需调整宿主机后端端口，应同步更新 VITE_APP_BASE_API
# CORS_ALLOWED_ORIGIN_PATTERNS 仅在前后端跨域部署时需要配置，多个来源用英文逗号分隔
# 本地联调通常可保留默认值
# -----------------------------------------------------------------------------

# 前端请求后端的基础地址
VITE_APP_BASE_API=http://localhost:8080/api

# 培优 / 外部页面地址：按需
VITE_PE_EXTERNAL_URL=

# CORS 白名单：仅前后端跨域部署时调整；同域反向代理通常无需修改
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# -----------------------------------------------------------------------------
# 4. 邮件、微信、对象存储、AI、短信等扩展能力
# 未启用的能力可保持空值
# -----------------------------------------------------------------------------

# 邮件：按需；启用邮箱验证码、反馈或工单通知时配置
# 常用必填项：EMAIL_SMTP_HOST / EMAIL_SMTP_USERNAME / EMAIL_SMTP_PASSWORD
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FEEDBACK=
EMAIL_TICKET=

# R2 / 对象存储：按需；启用文件上传时配置
# 常用必填项：R2_ENDPOINT / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
# R2_BUCKET_NAME 有默认值；R2_PRESIGN_ENDPOINT 可在 Docker 本地开发时填浏览器可访问的对象存储地址；
# R2_CUSTOM_DOMAIN 仅在自定义访问域名时填写
R2_ENDPOINT=
R2_PRESIGN_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gdeiassistant-userdata
# 图片私信：独立私有桶，必须与 R2_BUCKET_NAME 不同，禁止公开读取；为空时关闭新图片发送
R2_CHAT_BUCKET_NAME=
R2_CUSTOM_DOMAIN=

# 通用 AI：平台凭据只在后端配置，区域限制默认开启。
# 空模型配置使用官方别名或定期选取同系列最新版本；显式填写型号则固定该业务队列。
# CHAT_MODELS / OCR_MODEL 填写服务商的模型 ID，多个用逗号分隔，按顺序降级。
# OCR 只配置支持图片输入的模型。更多路由（summary 等）见 docs/AI_SERVICES.zh-CN.md。
# 演示环境可设为 false，允许已配置凭据的境内外端点参与调用与模型目录更新。
AI_REGION_RESTRICTION_ENABLED=true
AI_SERVICE_REGION=MAINLAND
AI_MODEL_AUTO_UPDATE=true
AI_MODEL_INITIAL_DELAY_MS=30000
AI_MODEL_REFRESH_MS=21600000

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODELS=
DOUBAO_OCR_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODELS=
DEEPSEEK_OCR_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODELS=
QWEN_OCR_MODEL=

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODELS=
SILICONFLOW_OCR_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODELS=
OPENAI_OCR_MODEL=

