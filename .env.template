ZHIPU_CHAT_MODELS=
ZHIPU_OCR_MODEL=

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_CHAT_MODELS=
MOONSHOT_OCR_MODEL=

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
