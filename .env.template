OPENCODE_OPENAI_BASE_URL=https://opencode.ai/inference/openai/v1
OPENCODE_OPENAI_CHAT_MODELS=
OPENCODE_OPENAI_OCR_MODEL=
OPENCODE_CLAUDE_BASE_URL=https://opencode.ai/inference/anthropic/v1
