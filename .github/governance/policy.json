{
  "version": "pr-governance/v3",
  "mode": "enforce",
  "review_routing": {
    "dispatch_mentions": [
      "@codex review",
      "@claude review"
    ]
  },
  "r0_paths": [
    "README.md"
  ],
  "r2_paths": [
    "src/main/java/cn/gdeiassistant/core/campuscredential/",
    "src/main/java/cn/gdeiassistant/core/userlogin/",
    "src/main/java/cn/gdeiassistant/core/charge/",
