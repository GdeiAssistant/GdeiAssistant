{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "generate:design-tokens": "node ../design/generate-tokens.mjs",
    "check:design-tokens": "node ../design/generate-tokens.mjs --check",
    "check:location-names": "node scripts/apply-location-names.mjs --check",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test --config=e2e/playwright.config.js",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "check:syntax": "node scripts/check-javascript-syntax.mjs"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cropperjs": "^2.3.0",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "fast-xml-parser": "^5.11.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0"
  }
}
